<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite name="OrangeHRM Automation Suite" verbose="1" parallel="false">

    <listeners>
        <listener class-name="com.qaframework.utils.AnnotationTransformer"/>
    </listeners>

    <test name="Login Module Tests">
        <classes>
            <class name="com.qaframework.tests.LoginTest"/>
        </classes>
    </test>

    <test name="Dashboard Module Tests">
        <classes>
            <class name="com.qaframework.tests.DashboardTest"/>
        </classes>
    </test>

    <test name="PIM Module Tests">
        <classes>
            <class name="com.qaframework.tests.PIMTest"/>
        </classes>
    </test>

</suite>
